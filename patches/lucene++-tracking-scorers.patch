+namespace Lucene {
+
+TrackingTermQuery::TrackingTermQuery(const TermPtr& term, size_t bitIndex, size_t num_terms,
+                      std::unordered_map<int32_t, boost::dynamic_bitset<>>* matchTracker) : TermQuery(term) {
