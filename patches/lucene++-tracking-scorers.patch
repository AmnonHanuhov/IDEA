+    this->num_terms = num_terms;
+    this->matchTracker = matchTracker;
+}
+
+TrackingTermWeight::~TrackingTermWeight() {
+}
+
+ScorerPtr TrackingTermWeight::scorer(const IndexReaderPtr& reader, bool scoreDocsInOrder, bool topScorer) {
+    TrackingTermQueryPtr trackingQuery = boost::dynamic_pointer_cast<TrackingTermQuery>(this->query);
+    TermDocsPtr termDocs(reader->termDocs(trackingQuery->getTerm()));
+    return termDocs ? newLucene<TrackingTermScorer>(shared_from_this(), termDocs, similarity, reader->norms((query->getTerm())->field()), bitIndex, num_terms, matchTracker) : ScorerPtr();
+}
+
+}
